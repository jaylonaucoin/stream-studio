{
  "name": "stream-studio",
  "version": "1.9.0",
  "description": "A desktop app to download and convert online videos/audio from 1000+ sites (YouTube, Vimeo, TikTok, Twitter, etc.) to various formats using yt-dlp and ffmpeg",
  "main": "main.js",
  "homepage": "https://github.com/jaylonaucoin/stream-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaylonaucoin/stream-studio.git"
  },
  "author": "Jaylon AuCoin",
  "email": "jaylonaucoin2013@hotmail.com",
  "license": "MIT",
  "scripts": {
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run build:renderer && electron-builder --publish never",
    "lint": "eslint src/ --ext .js,.jsx && eslint main.js preload.js main/**/*.js",
    "lint:fix": "eslint src/ --ext .js,.jsx --fix && eslint main.js preload.js main/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\" \"main/**/*.js\" \"main.js\" \"preload.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css}\" \"main/**/*.js\" \"main.js\" \"preload.js\"",
    "dev": "vite",
    "postinstall": "node scripts/download-binaries.js && node scripts/patch-music-metadata-id3-priv.js",
    "download-binaries": "node scripts/download-binaries.js",
    "build:renderer": "vite build",
    "start": "electron .",
    "build:mac": "npm run build:renderer && electron-builder --mac --x64",
    "build:win": "npm run build:renderer && electron-builder --win --x64",
    "build:linux": "npm run build:renderer && electron-builder --linux --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run stryker.conf.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "electron-store": "^11.0.2",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^12.1.0",
    "node-id3": "^0.2.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-image-crop": "^11.1.2",
    "react-imask": "^7.6.1"
  },
  "build": {
    "appId": "com.stream-studio.app",
    "productName": "Stream Studio",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "main/**/*",
      "shared/**/*",
      "preload.js",
      "dist-renderer/**/*",
      "assets/**/*",
      "!assets/README.md",
      "package.json",
      "node_modules/**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/*.d.ts",
      "!node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stream Studio"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "assets/icon.png"
    }
  }
}
